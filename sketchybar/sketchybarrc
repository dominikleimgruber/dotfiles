#!/usr/bin/env bash

PLUGIN_DIR="$HOME/.config/sketchybar/plugins"
ITEM_DIR="$HOME/.config/sketchybar/items"
export PLUGIN_DIR ITEM_DIR

source "$HOME/.config/sketchybar/colors.sh"
source "$HOME/.config/sketchybar/icons.sh"

# "SF Pro" carries the SF Symbols glyphs used in icons.sh.
# Hack Nerd Font stands in for the reference's SFMono Nerd Font, which isn't installed here.
export FONT="SF Pro"
export NERD_FONT="Hack Nerd Font"

sketchybar --bar height=30        \
                 blur_radius=30   \
                 position=top     \
                 padding_left=10  \
                 padding_right=10 \
                 color=$BAR_COLOR \
                 shadow=off

sketchybar --default updates=when_shown                  \
                     drawing=on                          \
                     icon.font="$FONT:Regular:14.0"      \
                     icon.color=$WHITE                   \
                     label.font="$FONT:Light:14.0"       \
                     label.color=$WHITE                  \
                     label.padding_left=4                \
                     label.padding_right=4               \
                     icon.padding_left=4                 \
                     icon.padding_right=4

# Left side
source "$ITEM_DIR/apple.sh"
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/front_app.sh"

# Right side (first sourced sits furthest right)
source "$ITEM_DIR/clock.sh"
source "$ITEM_DIR/weather.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/cpu.sh"
source "$ITEM_DIR/wifi.sh"
source "$ITEM_DIR/appearance.sh"

sketchybar --update

echo "sketchybar configuration loaded.."
